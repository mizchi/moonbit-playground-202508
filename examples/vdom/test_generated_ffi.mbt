// Test generated FFI code for JS backend

// Required type definitions
type JSValue
type Promise[T]
type Any

// Type alias
typealias Double as UserID

// Generated FFI bindings (as would be generated by the tool)

pub struct User {
  value : JSValue
}

// In JS backend, we would have access to JSValue methods
extern "js" fn JSValue::get(self : JSValue, key : String) -> JSValue = #|function(self, key) { return self[key]; }|#

// Helper functions to convert JSValue to MoonBit types
extern "js" fn jsvalue_to_double(value : JSValue) -> Double = #|function(v) { return v; }|#
extern "js" fn jsvalue_to_string(value : JSValue) -> String = #|function(v) { return v; }|#
extern "js" fn jsvalue_to_bool(value : JSValue) -> Bool = #|function(v) { return v; }|#

pub fn User::id(self : User) -> Double {
  jsvalue_to_double(self.value.get("id"))
}

pub fn User::name(self : User) -> String {
  jsvalue_to_string(self.value.get("name"))
}

pub fn User::email(self : User) -> String {
  jsvalue_to_string(self.value.get("email"))
}

pub fn User::isActive(self : User) -> Bool {
  jsvalue_to_bool(self.value.get("isActive"))
}

// Function bindings
extern "js" fn createUser(name : String, email : String) -> User = #|createUser|#

extern "js" fn fetchUser(id : UserID) -> Promise[User] = #|fetchUser|#

extern "js" fn getAllUsers_ffi() -> FixedArray[User] = #|getAllUsers|#

fn getAllUsers() -> Array[User] {
  Array::from_fixed_array(getAllUsers_ffi())
}

// Test function to verify type checking
pub fn test_js_ffi() -> Unit {
  let user = createUser("John", "john@example.com")
  let id : Double = user.id()
  let name : String = user.name()
  let email : String = user.email()
  let is_active : Bool = user.isActive()
  
  let user_id : UserID = 123.0
  let promise : Promise[User] = fetchUser(user_id)
  let users : Array[User] = getAllUsers()
  
  println("JS FFI type checking test completed")
}